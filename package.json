{
  "name": "arashi-presentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export --format pdf",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2 README.md",
    "test:command-policy": "node scripts/check-documented-command-policy.mjs",
    "validate": "pnpm run test:command-policy && pnpm run format:check && pnpm run lint:markdown && pnpm run build"
  },
  "dependencies": {
    "@slidev/cli": "52.17.0",
    "@slidev/theme-default": "latest",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.0",
    "playwright-chromium": "latest",
    "prettier": "3.9.5"
  }
}
